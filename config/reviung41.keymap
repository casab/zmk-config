#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

// Turkish-Q host layout
// ZMK sends key positions; the computer turns them into characters with its own
// keyboard layout. With the host set to Turkish-Q, these US-named keycodes type:
//   SEMI -> ş Ş     SQT  -> i İ     COMMA -> ö Ö     DOT -> ç Ç
//   FSLH -> . :     BSLH -> , ;     LEFT_BRACKET -> ğ Ğ     RIGHT_BRACKET -> ü Ü
//   GRAVE -> " é    NON_US_BSLH -> < > |
// The same on Windows and macOS (< > | confirmed on both).
// Shifted US keycodes follow the same rule: CARET (Shift+6) types &, AMPS (Shift+7) types /.
//
// Diagram notation: "tap/hold", e.g. "Esc/Npd" taps Esc and holds the numpad layer.
// ⌘ is LG(...) (Cmd on macOS, Win on Windows), ⇧ is Shift.

// Right-Alt (AltGr) symbols on Turkish-Q
#define _CURLY_OPEN RA(N7)
#define _CURLY_CLOSE RA(N0)
#define _AT_SIGN RA(Q)
#define _SQUARE_OPEN RA(N8)
#define _SQUARE_CLOSE RA(N9)
#define _DOLLAR_SIGN RA(N4)
#define _BACKSLASH RA(MINUS)
#define _VERTICAL_PIPE RA(EQUAL)
#define _BACKTICK RA(BACKSLASH)
#define _TILDE RA(RIGHT_BRACKET)
#define _NUMBER_SIGN RA(N3) //hashtag sign

// Layers
#define _QWERTY 0
#define _GAMING 1
#define _LOWER 2
#define _CMDSHIFT 3
#define _RAISE 4
#define _NUMPAD 5
#define _UTIL 6


/ {
        behaviors {
                h_alt: hold_alternative {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        tapping-term-ms = <130>;
                        quick-tap-ms = <0>;
                        flavor = "tap-preferred";
                        bindings = <&kp>, <&kp>;
                };
                hom: hold_only_multiple {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "tap-unless-interrupted";
                        tapping-term-ms = <300>;                        // hold only if another key is pressed within this time; a longer press alone is still a tap
                        quick-tap-ms = <200>;
                        bindings = <&kp>, <&kp>;
                };
                // Hold: Lower layer + Cmd (RGUI; Win on Windows), so Cmd+click and Cmd+left-hand keys work.
                // Nothing else is sent: like a real Win key, holding and releasing it alone may open Start.
                // wait-ms must stay 0 and no taps may be added: ZMK runs a macro immediately only up to
                // its first delay, and the keys the hold-tap held back are replayed right after. Earlier
                // extra taps landed on those keys (a Right Ctrl tap turned fast ? into Ctrl+?).
                lower_cmd: lower_cmd {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <0>;
                        tap-ms = <0>;
                        bindings
                                = <&macro_press &mo _LOWER &kp RGUI>
                                , <&macro_pause_for_release>
                                , <&macro_release &kp RGUI &mo _LOWER>;
                };
                // Same timing as the stock &lt: tap-preferred, 200 ms.
                lwr_cmd: lower_command {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "tap-preferred";
                        tapping-term-ms = <200>;
                        bindings = <&lower_cmd>, <&kp>;
                };
                mmlic: mm_lower_instant_comma {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&lwr_cmd 0 BSLH>, <&kp BSLH>;
                        mods = <(MOD_RSFT)>;
                        keep-mods = <(MOD_RSFT)>;
                }; 
                mmnet: mm_numpad_escape_tab {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&lt _NUMPAD ESC>, <&kp TAB>;
                        mods = <(MOD_LALT|MOD_LSFT|MOD_LCTL|MOD_LGUI)>;
                        keep-mods = <(MOD_LALT|MOD_LSFT|MOD_LCTL|MOD_LGUI)>;
                }; 
                prog_caps: behavior_prog_caps_word {
                        compatible = "zmk,behavior-caps-word";
                        #binding-cells = <0>;
                        continue-list = <PLUS>;
                };
                mt_cw: mod_tap_caps_word {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        tapping-term-ms = <100>;
                        flavor = "hold-preferred";
                        bindings = <&kp>, <&prog_caps>;
                };
                fmt: faster_mod_tap {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        tapping-term-ms = <100>;
                        flavor = "hold-preferred";
                        bindings = <&kp>, <&kp>;
                };

                // Gaming indicator: solid purple while the gaming layer is on, LEDs off otherwise.
                gaming_on: gaming_on {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <0>;
                        tap-ms = <0>;
                        bindings
                                = <&macro_tap &to _GAMING>
                                , <&macro_tap &rgb_ug RGB_ON &rgb_ug RGB_EFS_CMD 0 &rgb_ug RGB_COLOR_HSB(270,100,50)>;
                };
                gaming_off: gaming_off {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <0>;
                        tap-ms = <0>;
                        bindings
                                = <&macro_tap &to _QWERTY>
                                , <&macro_tap &rgb_ug RGB_OFF>;
                };

                // Lower-layer keys that drop the Cmd held by the Lower thumb, so they type as plain keys.
                nc_caret: nc_caret { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp CARET>, <&kp CARET>; mods = <(MOD_RGUI)>; };
                nc_amps: nc_amps { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp AMPS>, <&kp AMPS>; mods = <(MOD_RGUI)>; };
                nc_astrk: nc_astrk { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp ASTERISK>, <&kp ASTERISK>; mods = <(MOD_RGUI)>; };
                nc_lpar: nc_lpar { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp LPAR>, <&kp LPAR>; mods = <(MOD_RGUI)>; };
                nc_rpar: nc_rpar { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RPAR>, <&kp RPAR>; mods = <(MOD_RGUI)>; };
                nc_under: nc_under { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp UNDERSCORE>, <&kp UNDERSCORE>; mods = <(MOD_RGUI)>; };
                nc_left: nc_left { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp LEFT>, <&kp LEFT>; mods = <(MOD_RGUI)>; };
                nc_down: nc_down { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp DOWN>, <&kp DOWN>; mods = <(MOD_RGUI)>; };
                nc_up: nc_up { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp UP>, <&kp UP>; mods = <(MOD_RGUI)>; };
                nc_right: nc_right { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RIGHT>, <&kp RIGHT>; mods = <(MOD_RGUI)>; };
                nc_minus: nc_minus { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp MINUS>, <&kp MINUS>; mods = <(MOD_RGUI)>; };
                nc_equal: nc_equal { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp EQUAL>, <&kp EQUAL>; mods = <(MOD_RGUI)>; };
                nc_lbrc: nc_lbrc { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp _CURLY_OPEN>, <&kp _CURLY_OPEN>; mods = <(MOD_RGUI)>; };
                nc_lbkt: nc_lbkt { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp _SQUARE_OPEN>, <&kp _SQUARE_OPEN>; mods = <(MOD_RGUI)>; };
                nc_rbkt: nc_rbkt { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp _SQUARE_CLOSE>, <&kp _SQUARE_CLOSE>; mods = <(MOD_RGUI)>; };
                nc_rbrc: nc_rbrc { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp _CURLY_CLOSE>, <&kp _CURLY_CLOSE>; mods = <(MOD_RGUI)>; };
                nc_plus: nc_plus { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp PLUS>, <&kp PLUS>; mods = <(MOD_RGUI)>; };
        };



        keymap {
                compatible = "zmk,keymap";

                default_layer {
// ---------------------------------------------------------------------------------------
// | Esc/Npd |  Q  |  W  |  E  |  R  |  T  |   |  Y  | U/Ü |  I  |  O  |  P  | Bspc/RSft |
// | CpsW/Sft|  A  |  S  |  D  |  F  | G/Ğ |   |  H  |  J  |  K  |  L  |  Ş  |     İ     |
// | Tab/Ctl |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  Ö  |  Ç  |  .  |   Enter   |
//                      | ⌘/Alt | ,/Lwr⌘ | Space | "/Rse | RAlt |
// Esc/Npd sends Tab while a left modifier is held. ,/Lwr sends ; while Right Shift is held.
// Holding ,/Lwr also holds ⌘ (Lwr⌘), so ⌘+click and ⌘+left-hand keys work like a normal keyboard.
                        bindings = <
   &mmnet  &kp Q  &kp W  &kp E  &kp R  &kp T                &kp Y  &h_alt RIGHT_BRACKET U  &kp I  &kp O  &kp P  &hom RSHFT BSPC
   &mt_cw LSHFT 0  &kp A  &kp S  &kp D  &kp F  &h_alt LEFT_BRACKET G      &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT
   &fmt LCTRL TAB  &kp Z  &kp X  &kp C  &kp V  &kp B                 &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RET
        &h_alt LALT LGUI        &mmlic      &kp SPACE    &lt _RAISE GRAVE    &kp RALT
                        >;
                };


                gaming_layer {
// ---------------------------------------------------------------------------------------
// | Esc/Npd |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | Bspc/RSft |
// |  LSft   |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  Ş  |   İ/Tab   |
// |  LCtl   |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  Ö  |  Ç  |  .  |   Enter   |
//                      |  Alt  | ,/Lwr | Space | "/Rse | Gaming off |
// ,/Lwr here doesn't hold ⌘, so games never get a Win/Cmd press.
                        bindings = <
   &lt _NUMPAD ESC  &kp Q  &kp W  &kp E  &kp R  &kp T                &kp Y  &kp U  &kp I  &kp O  &kp P  &hom RSHFT BSPC
   &kp LSHFT &kp A  &kp S  &kp D  &kp F  &kp G      &kp H  &kp J  &kp K  &kp L  &kp SEMI  &h_alt TAB SQT
   &kp LCTRL &kp Z  &kp X  &kp C  &kp V  &kp B                 &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RET
        &kp LALT       &lt _LOWER BSLH          &kp SPACE    &lt _RAISE GRAVE       &gaming_off
                        >;
                };

                lower_layer {
// ---------------------------------------------------------------------------------------
// | ⌘Tab  | ⌘Q  | ⌘W  | ⌘E  | ⌘R  | ⌘T  |   |  &  |  /  |  (  |  )  |  =  |  ?  |
// | ⇧⌘Lyr | ⌘A  | ⌘S  | ⌘D  | ⌘F  | ⌘G  |   |Left |Down | Up  |Right|  *  |  -  |
// | ⌘Ctl  | ⌘Z  | ⌘X  | ⌘C  | ⌘V  | ⌘B  |   | ⌘N  |  {  |  [  |  ]  |  }  |  _  |
//                      | ⌘Alt  | (held) | ⌘Space | ⌘"/Util |     |
// ⇧⌘Lyr holds the Cmd+Shift layer. The Lower thumb holds ⌘ (except from the gaming layer);
// the symbols and arrows on the right drop it (nc_* behaviors), so they type as plain keys.
                        bindings = <
   &kp LG(TAB)     &kp LG(Q)  &kp LG(W)  &kp LG(E)  &kp LG(R)  &kp LG(T)                    &nc_caret  &nc_amps  &nc_astrk  &nc_lpar &nc_rpar  &nc_under
   &mo _CMDSHIFT &kp LG(A) &kp LG(S) &kp LG(D) &kp LG(F) &kp LG(G)                     &nc_left  &nc_down  &nc_up  &nc_right &nc_minus  &nc_equal
   &kp LG(LCTRL)  &kp LG(Z) &kp LG(X) &kp LG(C) &kp LG(V) &kp LG(B)                  &kp LG(N)  &nc_lbrc  &nc_lbkt  &nc_rbkt  &nc_rbrc  &nc_plus
                                             &kp LG(LALT)  &trans    &kp LG(SPACE)    &lt _UTIL LG(GRAVE) &trans
                        >;
                };

                cmdshift_layer {
// ---------------------------------------------------------------------------------------
// Every key except the blanks and the right thumbs sends ⇧⌘ + that key.
// | ⇧⌘Tab  |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |       |
// | (held) |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  Ş  |   İ   |
// | ⇧⌘Ctl  |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  Ö  |  Ç  |  .  |       |
//                      | ⇧⌘Alt |       | ⇧⌘Space | "/Rse | RAlt |
                        bindings = <
   &kp LG(LS(TAB))  &kp LG(LS(Q))  &kp LG(LS(W))  &kp LG(LS(E))  &kp LG(LS(R))  &kp LG(LS(T))                &kp LG(LS(Y))  &kp LG(LS(U))  &kp LG(LS(I))  &kp LG(LS(O))  &kp LG(LS(P))  &none
   &trans        &kp LG(LS(A))  &kp LG(LS(S))  &kp LG(LS(D))  &kp LG(LS(F))  &kp LG(LS(G))                  &kp LG(LS(H))  &kp LG(LS(J))  &kp LG(LS(K))  &kp LG(LS(L))  &kp LG(LS(SEMI))  &kp LG(LS(SQT))
   &kp LG(LS(LCTRL)) &kp LG(LS(Z))  &kp LG(LS(X))  &kp LG(LS(C))  &kp LG(LS(V))  &kp LG(LS(B))           &kp LG(LS(N))  &kp LG(LS(M))  &kp LG(LS(COMMA))  &kp LG(LS(DOT))  &kp LG(LS(FSLH))  &none
                          &kp LG(LS(LALT))        &none          &kp LG(LS(SPACE))    &lt _RAISE GRAVE    &kp RALT
                        >;
                };

                raise_layer {
// ---------------------------------------------------------------------------------------
// |  "  |  !  |  '  |  ^  |  +  |  %  |   |  &  |  /  |  (  |  )  |  =  |  ?  |
// |  <  |  >  |  `  |  #  |  $  |     |   |Home |PgDn |PgUp | End |  \  |  ~  |
// |  |  |  @  |     |     |     |     |   |     |  {  |  [  |  ]  |  }  |  _  |
//                      |       | Util  |  Del  | (held) |      |
                        bindings = <
   &kp GRAVE     &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT                                       &kp CARET  &kp AMPS  &kp ASTERISK  &kp LPAR &kp RPAR  &kp UNDERSCORE
   &kp NON_US_BSLH  &kp LS(NON_US_BSLH) &kp _BACKTICK  &kp _NUMBER_SIGN  &kp _DOLLAR_SIGN  &none        &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END &kp _BACKSLASH  &kp _TILDE
   &kp _VERTICAL_PIPE  &kp _AT_SIGN  &none  &none  &none  &none                                                       &none  &kp _CURLY_OPEN  &kp _SQUARE_OPEN  &kp _SQUARE_CLOSE  &kp _CURLY_CLOSE  &kp PLUS
                                                        &trans  &mo _UTIL    &kp DEL    &trans    &trans 
                        >;
                };

                // KP_DOT is comma on the Turkish layout ¯\_(ツ)_/¯
                numpad_layer {
// ---------------------------------------------------------------------------------------
// |     |     |     |     |     |     |   |  =  |  7  |  8  |  9  |  -  | Bspc |
// | F1  | F2  | F3  | F4  | F5  | F6  |   |  .  |  4  |  5  |  6  |  +  |  *   |
// | F7  | F8  | F9  | F10 | F11 | F12 |   |  ,  |  1  |  2  |  3  |  .  |  /   |
//                      |       |       | Space |   0   |  0   |
// The digits are number-row keys; - + , / are keypad keys; = is Shift+0 (keypad = doesn't type on Windows).
                        bindings = <
   &none  &none  &none  &none  &none  &none                     &kp RPAR  &kp N7  &kp N8  &kp N9  &kp KP_MINUS  &kp BSPC
   &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                     &kp SLASH  &kp N4  &kp N5  &kp N6  &kp KP_PLUS  &kp MINUS
   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12                     &kp KP_DOT &kp N1  &kp N2  &kp N3  &kp SLASH  &kp KP_SLASH
                                &none  &none    &kp SPACE   &kp N0   &kp N0 
                        >;
                };

                util_layer {
// ---------------------------------------------------------------------------------------------------------------
// | RGB BRI+ | RGB SAT+ | RGB HUE+ | RGB EFF+ |    | RGB TOG |   |  BT1  | BT2 | BT3 | BT4 | BT5   |  BT CLR  |
// | RGB BRI- | RGB SAT- | RGB HUE- | RGB EFF- |    |         |   |       |     |     |     |       |  RESET   |
// |   Brgt▼  |  Brgt▲   |   Prev   |   Next   |Vol-|    Vol+ |   |PlayPse|     |     |     |EXT PWR|BOOTLOADER|
//                               |     |     |Gaming on (purple)|     |     |
// BT CLR clears only the selected profile. EXT PWR toggles the external power rail that feeds the RGB LEDs.
                        bindings = <
   &rgb_ug RGB_BRI &rgb_ug RGB_SAI &rgb_ug RGB_HUI &rgb_ug RGB_EFF &none &rgb_ug RGB_TOG    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR
   &rgb_ug RGB_BRD &rgb_ug RGB_SAD &rgb_ug RGB_HUD &rgb_ug RGB_EFR &none &none              &none        &none        &none        &none        &none        &sys_reset
   &kp C_BRI_DEC  &kp C_BRI_INC  &kp C_PREV &kp C_NEXT  &kp C_VOL_DN &kp C_VOL_UP           &kp C_PLAY_PAUSE  &none        &none        &none    &ext_power EP_TOG        &bootloader
                                                      &trans      &trans       &gaming_on        &trans      &trans
                        >;
                };
        };
};
